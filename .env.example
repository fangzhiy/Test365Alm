# Development-only values. Copy to .env and do not commit the copy.
POSTGRES_DB=test365alm
POSTGRES_USER=test365alm
POSTGRES_PASSWORD=test365alm_dev_password
POSTGRES_HOST_PORT=54329

# Spring Boot reads these environment variables when the server runs on the host.
TEST365ALM_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54329/test365alm
TEST365ALM_DATASOURCE_USERNAME=test365alm
TEST365ALM_DATASOURCE_PASSWORD=test365alm_dev_password
TEST365ALM_DB_CONNECTION_TIMEOUT_MS=2000
TEST365ALM_READINESS_TIMEOUT_MS=2000
